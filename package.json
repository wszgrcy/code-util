{
  "name": "cyia-code-util",
  "version": "0.0.0",
  "description": "代码工具",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf dist && rimraf temp/antlr  && npm run build:ts && npm run build:type   && cpx  ./script/asset/**/* ./dist ",
    "test": "rimraf ./test-dist && tsx --tsconfig ./tsconfig.script.json ./script/test.esbuild.ts && mocha \"./test-dist/**/*.spec.mjs\" --enable-source-maps --inspect",
    "coverage": "c8 npm run test",
    "deploy": "typedoc --out docs src/index.ts",
    "release-publish": "npm run build && npm  --registry=http://lan-server.chloc:5555 publish ./dist",
    "build:antlr-language": "rimraf ./src/antlr/grammars && node --import tsx/esm ./script/antlr-convert.ts ",
    "build:extname": "node --import tsx/esm ./script/ext/main.ts",
    "build:ts": "tsx --tsconfig ./tsconfig.script.json ./script/ts-build.esbuild.ts",
    "build:type": "tsc -P ./tsconfig.build-type.json ",
    "build:tree-sitter": "node --import tsx/esm ./script/tree-sitter-build.ts",
    "copy:tree-sitter": "cpx ./lib/tree-sitter/**/* ../tree-sitter-build",
    "lint": "eslint --fix src --ext ts && prettier ./src --write",
    "build:antlr-language:esbuild": "rimraf ./packages/antlr/grammars && rimraf ./packages/antlr/chunk*.js && tsx --tsconfig ./tsconfig.script.json ./script/antlr.esbuild.ts && cpx ./src/antlr/grammars/*.json ./packages/antlr",
    "publish:parser-antlr": "npm run build:antlr-language:esbuild && npm publish ./packages/antlr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wszgrcy/cyia-code-util.git"
  },
  "author": "wszgrcy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wszgrcy/cyia-code-util/issues"
  },
  "homepage": "https://github.com/wszgrcy/cyia-code-util#readme",
  "devDependencies": {
    "@commitlint/cli": "^18",
    "@commitlint/config-conventional": "^18",
    "@lezer/cpp": "^1.1.2",
    "@lezer/css": "^1.1.8",
    "@lezer/html": "^1.3.9",
    "@lezer/java": "^1.1.1",
    "@lezer/javascript": "^1.4.14",
    "@lezer/json": "^1.0.2",
    "@lezer/lezer": "^1.1.2",
    "@lezer/markdown": "^1.3.0",
    "@lezer/php": "^1.0.2",
    "@lezer/python": "^1.1.13",
    "@lezer/rust": "^1.0.2",
    "@lezer/sass": "^1.0.6",
    "@lezer/xml": "^1.0.5",
    "@microsoft/api-extractor": "^7.40.3",
    "@types/chai": "^4.3.11",
    "@types/css-tree": "^2.3.1",
    "@types/inquirer": "^7.3.1",
    "@types/lodash": "^4.14.195",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.17.0",
    "@types/normalize-path": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "c8": "^9.1.0",
    "chai": "^5.1.0",
    "cpx": "^1.5.0",
    "didyoumean2": "^6.0.1",
    "esbuild": "^0.25.2",
    "eslint": "^8.56.0",
    "execa": "^9.6.1",
    "fastest-levenshtein": "^1.0.16",
    "fastq": "^1.16.0",
    "glob": "^10.3.3",
    "husky": "^4.3.7",
    "lodash": "^4.17.21",
    "mocha": "^10.3.0",
    "nyc": "^15.1.0",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.1.3",
    "rimraf": "^5.0.1",
    "tree-sitter-cli": "^0.26.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.2",
    "typedoc": "0.28.1",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@angular/compiler": "17.3.5",
    "@vue/compiler-dom": "3.4.23",
    "antlr4": "^4.13.2",
    "chevrotain": "^11.0.3",
    "css-tree": "^2.3.1",
    "css-what": "6.1.0",
    "htmlparser2": "^9.1.0",
    "inquirer": "^7.3.3",
    "jsonc-parser": "^3.2.1",
    "magic-string": "^0.30.10",
    "normalize-path": "^3.0.0",
    "nth-check": "^2.1.1",
    "pgsql-ast-parser": "12.0.1",
    "web-tree-sitter": "^0.26.8",
    "yaml": "^2.4.1"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "pretty-quick --staged"
    }
  }
}
