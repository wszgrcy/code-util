{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.xspec.ts", "src/antlr/grammars/**/*.ts"],
  "compilerOptions": {
    "outDir": "dist",
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "node",
    "allowJs": true,
    "strict": false,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  }
}
